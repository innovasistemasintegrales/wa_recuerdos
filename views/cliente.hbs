    <section class="slider">
        <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="https://marketplace.canva.com/EAFHuAOR-DI/1/0/1600w/canva-collage-de-fotos-horizontal-de-viaje-moderno-color-blanco-iNEXn2EJVaA.jpg"
                        class="d-block w-100 img-slider1" alt="...">
                </div>
                <div class="carousel-item">
                    <img src="https://i.ytimg.com/vi/dsq_4o3UKT8/hq720.jpg?sqp=-oaymwE7CK4FEIIDSFryq4qpAy0IARUAAAAAGAElAADIQj0AgKJD8AEB-AH-CYAC0AWKAgwIABABGFogSyhlMA8=&rs=AOn4CLAavhbst5VrtZSsGaJsTuouJ-Ii2A"
                        class="d-block w-100 img-slider2" alt="...">
                </div>
                <div class="carousel-item">
                    <img src="https://lh5.googleusercontent.com/-9KqBk-sO35E/U0A3kOQE-0I/AAAAAAAAO10/ZaaJvnh7UpI/s1024/SLIDER%2520recuerdos%25202013.jpg"
                        class="d-block w-100 img-slider3" alt="...">
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls"
                data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls"
                data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </section>

    <section id="contenedorPrincipal">
        <div class="row">
            <div class="col">
                {{!-- Card Global reactivo --}}
                <div id="contenedorReactivo">
                    {{!-- Aqui va todo el contenido iniciar y los reactivos --}}



                    {{!-- Tempate del contenido Mi galeria --}}
                    <template id="templateGaleria">
                        <div>
                            <span class="text-black mi-galeria">Hola soy la seccion galeria</span>
                        </div>
                    </template>
                    {{!-- Tempate del contenido Mi album --}}
                    <template id="templateAlbum">
                        <span class="text-black mi-album">Hola soy la seccion álbum</span>
                    </template>
                    {{!-- Tempate del contenido notificación --}}
                    <template id="templateNotificacion">
                        <span class="text-black notificaciones">Hola soy la seccion Notificación</span>
                    </template>
                    {{!-- Tempate del contenido configuración --}}
                    <template id="templateConfiguracion">
                        <span class="text-black configuracion">Hola soy la seccion Configuración</span>
                        <div class=" mt-4">
                            <div class="perfil-container">

                                <div class="container perfil-container">
                                    <h3 class="text-center">Mi Perfil</h3>

                                    <div class="row">
                                        <div class="col-12 col-sm-6 d-flex justify-content-center align-items-center">
                                            <div class="">
                                                <img src="/img/perfil.png" class="perfil-img"
                                                    alt="Foto de perfil">
                                            </div>

                                        </div>
                                        <div class="col-12 col-sm-6">
                                            <div class="form-group">
                                                <label class="form-label">Nombre:</label>
                                                <input type="nombre" class="form-control"
                                                    placeholder="Jose Perez">
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Username:</label>
                                                <input type="Username" class="form-control"
                                                    placeholder="pepito">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12 col-sm-6">
                                            <div class="form-group">
                                                <label class="form-label">Email:</label>
                                                <input type="email" class="form-control"
                                                    placeholder="pepitoperez@gmail.com">
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Contraseña Antigua:</label>
                                                <input type="password" class="form-control"
                                                    placeholder="********">
                                            </div>
                                        </div>

                                        <div class="col-12 col-sm-6">
                                            <div class="form-group">
                                                <label class="form-label">Telefono:</label>
                                                <input type="telefono" class="form-control"
                                                    placeholder="987654321">
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Contraseña Nueva:</label>
                                                <input type="password" class="form-control"
                                                    placeholder="********">
                                            </div>
                                            <div class="mt-4 d-flex justify-content-end">
                                                <button type="submit" class="btn btn-success ms-auto">Guardar
                                                    Cambios</button>
                                            </div>
                                        </div>

                                    </div>
                                </div>

                            </div>

                            </form>
                        </div>
                    </template>

                </div>
            </div>
    </section>
</div>

