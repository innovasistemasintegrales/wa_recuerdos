                        <div class="titulo"><span>Mi galeria</span></div>
                    </a>
                </div>
                <div class="item-separator">
                </div>
                <div class="item">
                    <a href="#" id="btnMenuAlbum">
                        <div class="icono"><img src="/icons/asesoria.png" alt=""></div>
                        <div class="titulo"><span>Mis albumes</span></div>
                    </a>
                </div>
                <div class="item-separator">
                </div>
                <div class="item">
                    <a href="#" id="btnMenuNotificacion">
                        <div class="icono"><img src="/icons/asesoria.png" alt=""></div>
                        <div class="titulo"><span>Notificaciones</span></div>
                    </a>
                </div>
                <div class="item-separator">
                </div>
                <div class="item">
                    <a href="#" id="btnMenuConfiguracion">
